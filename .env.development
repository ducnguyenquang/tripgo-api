PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase (sign up at https://supabase.com - free tier)
# Go to: Project Settings > Database > Connection string (URI)
DATABASE_URL=
# Go to: Project Settings > API > Project URL
SUPABASE_URL=
# Go to: Project Settings > API > service_role key (secret)
SUPABASE_SERVICE_KEY=

# Upstash Redis (sign up at https://console.upstash.com - free tier)
# Create database > copy Redis URL
REDIS_URL=

# Cloudflare R2 (optional for dev - image uploads won't work without it)
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=tripgo-dev

# OSRM (optional for dev - route calculation won't work without it)
OSRM_URL=https://router.project-osrm.org

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
